rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /departments/{id} {
      allow read, write: if true;
    }

    match /lecturers/{id} {
      allow read, write: if true;
    }

    match /classrooms/{id} {
      allow read, write: if true;
    }

    match /programs/{id} {
      allow read, write: if true;
    }

    match /batches/{id} {
      allow read, write: if true;
    }

    match /modules/{id} {
      allow read, write: if true;
    }

    match /timeSlots/{id} {
      allow read, write: if true;
    }

    match /academicWeeks/{id} {
      allow read, write: if true;
    }

    match /schedules/{id} {
      allow read, write: if true;
    }

    match /systemSettings/{id} {
      allow read, write: if true;
    }

    match /users/{id} {
      allow read, write: if true;
    }

    match /activityLogs/{id} {
      allow read, write: if true;
    }
  }
}
